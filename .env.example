# ============================================================
# LungSight AI — Environment Variables
# ============================================================

# ---- Application ----
APP_NAME=LungSight AI
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://lungs_user:lungs_pass@localhost:5432/lungsight_db
DATABASE_URL_SYNC=postgresql://lungs_user:lungs_pass@localhost:5432/lungsight_db
POSTGRES_DB=lungsight_db
POSTGRES_USER=lungs_user
POSTGRES_PASSWORD=lungs_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis (caching & celery) ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT Auth ----
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- ML Models ----
MODELS_DIR=./backend/models/weights
DEVICE=cuda
MODEL_BATCH_SIZE=1
IMAGE_SIZE=224

# ---- File Storage ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=png,jpg,jpeg,dcm,dicom

# ---- Report Generation ----
REPORTS_DIR=./reports/generated
HOSPITAL_NAME=LungSight Medical Center
HOSPITAL_LOGO_PATH=./static/logo.png

# ---- TensorBoard ----
TENSORBOARD_LOG_DIR=./tb_logs

# ---- Monitoring ----
SENTRY_DSN=
PROMETHEUS_PORT=9090

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=LungSight AI
NEXT_PUBLIC_APP_VERSION=1.0.0
